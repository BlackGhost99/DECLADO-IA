# Copier en .env pour le développement local. Ne jamais committer de .env réel.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://clairtransit:clairtransit@localhost:5432/clairtransit
CELERY_BROKER_URL=redis://localhost:6379/0
# Origines autorisées pour CSRF (serveur Vite en développement)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Stockage privé des pièces (hors racine web) et limites de dépôt
# PRIVATE_STORAGE_ROOT=/chemin/absolu  (défaut : backend/var/private)
DOCUMENT_MAX_BYTES=52428800
DOCUMENT_LINK_TTL_SECONDS=300
# ClamAV requis pour tous les uploads. Ne jamais exposer clamd sur Internet.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT=5
CLAMAV_SCAN_TIMEOUT=120
# Lot 3 : extraction assistée
EXTRACTION_MAX_PAGES=500
OCR_LANGUAGES=fra+eng
OCR_PAGE_TIMEOUT_SECONDS=120
# Numérisation : pages au plus par lot
SCAN_BATCH_MAX_PAGES=300
# Relance de la boîte d'envoi par Celery beat (secondes)
OUTBOX_POLL_SECONDS=30
# IA en ligne : désactivée par défaut, chaque société l'active ensuite elle-même.
AI_PROVIDER=disabled
# IA en ligne facultative : AI_PROVIDER=anthropic (usage réel) ou gemini (essais, offre gratuite).
# AI_API_KEY=
# AI_MODEL=  # défaut : claude-haiku-5-5 (anthropic) ou gemini-3.5-flash-lite (gemini)
# AI_FREE_TIER=false

# MFA obligatoire en production et cache Redis partagé. Ne jamais publier la clé.
MFA_ENFORCE=false
# MFA_ENCRYPTION_KEY=...  (Fernet.generate_key, requise en production)
AUTH_RATE_LIMIT_ENABLED=false
CACHE_URL=redis://localhost:6379/1
