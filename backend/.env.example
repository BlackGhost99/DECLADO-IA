# Copier en .env pour le développement local. Ne jamais committer de .env réel.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://clairtransit:clairtransit@localhost:5432/clairtransit
CELERY_BROKER_URL=redis://localhost:6379/0
# Origines autorisées pour CSRF (serveur Vite en développement)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
