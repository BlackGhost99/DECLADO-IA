# ==========================================
# DECLADO-IA - Environment Variables (EXAMPLE)
# ==========================================
# IMPORTANT: Ne JAMAIS committer le fichier .env réel
# Copier ce fichier vers .env et remplir avec vos valeurs

# ==========================================
# Application
# ==========================================
APP_NAME=DECLADO-IA
APP_VERSION=0.1.0
APP_ENV=development  # development, staging, production
DEBUG=true

# ==========================================
# API Backend
# ==========================================
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true  # Auto-reload en dev

# CORS (Frontend Electron)
CORS_ORIGINS=http://localhost:5173,app://declado-ia

# ==========================================
# Base de données
# ==========================================
# SQLite local (chiffré)
DATABASE_URL=sqlite:///./data/declado.db
DATABASE_ENCRYPTION_KEY=changeme_with_32_byte_key_here_please_change_this

# PostgreSQL (pour déploiement cloud)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/declado_ia

# ==========================================
# Sécurité & JWT
# ==========================================
SECRET_KEY=changeme_super_secret_key_for_jwt_signing_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# OCR & ML
# ==========================================
# Tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANG=fra+eng

# Modèles ML
ML_MODELS_PATH=./ml/models
ML_CONFIDENCE_THRESHOLD=0.75

# ==========================================
# MLflow (Tracking ML)
# ==========================================
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=declado-ia-classification

# ==========================================
# Licences & Cloud (optionnel)
# ==========================================
LICENSE_SERVER_URL=https://licenses.declado-ia.com/api/v1
LICENSE_KEY=

# Cloud sync (optionnel)
CLOUD_SYNC_ENABLED=false
CLOUD_STORAGE_URL=
CLOUD_API_KEY=

# ==========================================
# Logs
# ==========================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/declado-ia.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# ==========================================
# Référentiels CEMAC
# ==========================================
REFERENTIALS_PATH=./data/referentials
AUTO_UPDATE_REFERENTIALS=false
BEAC_RATES_UPDATE_INTERVAL=daily

# ==========================================
# Export
# ==========================================
EXPORT_PATH=./data/exports
PDF_TEMPLATE_PATH=./templates/pdf
XML_SCHEMA_PATH=./templates/xml/esad_schema.xsd

# ==========================================
# Sécurité antivirus (optionnel)
# ==========================================
ANTIVIRUS_ENABLED=false
ANTIVIRUS_PATH=C:\Program Files\ClamAV\clamscan.exe

# ==========================================
# Monitoring (Sentry - optionnel)
# ==========================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
