# Staging Docker image: same-origin React + Django.
FROM node:24-bookworm-slim AS frontend_build
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-fund --no-audit
COPY frontend/ ./
RUN npm run build

FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-fra tesseract-ocr-eng \
    tesseract-ocr-spa tesseract-ocr-ara \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir gunicorn==23.0.0 whitenoise==6.9.0
COPY backend/ /app/
COPY --from=frontend_build /frontend/dist/ /app/frontend_dist/
COPY render/staging-start.sh /app/staging-start.sh
RUN chmod 755 /app/staging-start.sh \
    && useradd --create-home app \
    && mkdir -p /app/staticfiles /var/clairtransit/private \
    && chown -R app:app /app /var/clairtransit
ENV SERVE_FRONTEND=true FRONTEND_DIST_DIR=/app/frontend_dist \
    DJANGO_SETTINGS_MODULE=config.settings
RUN DJANGO_DEBUG=true python manage.py collectstatic --noinput
USER app
EXPOSE 10000
CMD ["/app/staging-start.sh"]
